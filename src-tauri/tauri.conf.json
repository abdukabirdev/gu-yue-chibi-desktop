{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chibi Walker",
  "version": "0.1.0",
  "identifier": "uz.abdukabir.chibiwalker",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Chibi Walker",
        "url": "index.html",
        "width": 800,
        "height": 600,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Чиби-маскот на рабочем столе",
    "windows": {
      "nsis": {
        "languages": ["Russian"],
        "installMode": "currentUser"
      }
    }
  }
}
